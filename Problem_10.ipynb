   "source": [
    "#### Create a *2 × 3 NumPy array* containing:\n",
    "\n",
    "`text`\n",
    "<br>\n",
    "`1  2  3`\n",
    "<br>\n",
    "`4  5  6`\n",
    "#### Then print its *shape*"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "a03441ca",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Shape of the 2D array: (2, 3)\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "shapes = np.array([[1,2,3],[4,5,6]])\n",
    "\n",
    "print_shape = shapes.shape\n",
    "print(\"Shape of the 2D array:\",print_shape)"
   ]
  }
 ],
