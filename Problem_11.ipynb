   "source": [
    "import numpy as np\n",
    "\n",
    "array_1 = np.arange(1,4)#[1,2,3]\n",
    "array_2 = np.arange(4,7)#[4,5,6]\n",
    "merged_array = np.concatenate((array_1,array_2))\n",
    "print(\"Merged array:\",merged_array)\n",
    "\n"
   ]
  }
